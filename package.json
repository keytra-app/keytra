{
  "name": "keytra",
  "version": "0.1.0",
  "description": "Minimalist, self-hosted, open-source alternative to Crowdin.",
  "license": "MIT",
  "homepage": "https://github.com/keytra-app/keytra#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keytra-app/keytra.git"
  },
  "bugs": {
    "url": "https://github.com/keytra-app/keytra/issues"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:migrate": "esbuild src/db/migrate.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/migrate.mjs --external:pg-native --banner:js=\"import{createRequire}from'node:module';const require=createRequire(import.meta.url);\"",
    "start": "next start",
    "lint": "eslint",
    "db:up": "docker compose -f docker-compose.dev.yml up -d --wait",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "db:reset": "docker compose -f docker-compose.dev.yml down -v && pnpm db:up && pnpm db:migrate",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node src/db/migrate.ts",
    "db:seed": "node src/db/seed.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "fflate": "^0.8.3",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.5",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "esbuild": "0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.5",
    "typescript": "^5",
    "vitest": "^5.1.2"
  },
  "packageManager": "pnpm@12.18.0"
}
