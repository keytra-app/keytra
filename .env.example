# Local dev: copy to .env.local. For `docker compose` use a minimal .env (see README.md),
# never this DATABASE_URL: 127.0.0.1 is unreachable from inside the container.
# Postgres connection (matches docker-compose.dev.yml defaults)
DATABASE_URL=postgres://keytra:keytra@127.0.0.1:5432/keytra
# Session signing secret; generate with: openssl rand -base64 32
AUTH_SECRET=change-me
# Public base URL of the app
APP_URL=http://localhost:3000
# Optional: host port for the dev DB (export in shell; keep DATABASE_URL in sync)
# POSTGRES_DEV_PORT=5432
# Optional: auto-create the first admin on first start (only while no user exists)
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me-please
# ADMIN_NAME=Admin
